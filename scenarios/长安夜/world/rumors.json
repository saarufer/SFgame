  "rumors": [
    {
      "id": "R1",
      "text": "长安天子本姓韩，金陵才是真李唐。",
      "truth": "半真",
      "source": "沈知微",
      "about": [
        "李洙",
        "李璟"
      ],
      "heat": {
        "长安市井": 2,
        "诸蕃": 1,
        "江南": 3
      },
      "cred": 2,
      "status": "流传",
      "effects": {
        "李洙": {
          "市井": -1
        }
      },
      "applied": {},
      "since_turn": 1,
      "when": "承平二十七年春",
      "age": 0,
      "gm_note": "“本姓韩”是真的（天祐十九年先帝收为皇子、赐国姓，太庙册文写着，士林人人知道）；“金陵才是真李唐”是江南的说法。话是汲古斋的沈知微散的，经西市的胡商、说书人传开。",
      "log": []
    },
    {
      "id": "R2",
      "text": "圣上射柳只射一箭，是手臂旧伤犯了。",
      "truth": "假",
      "source": "严承恩",
      "about": [
        "李洙"
      ],
      "heat": {
        "宫中": 2,
        "朝堂": 2,
        "长安市井": 1
      },
      "cred": 3,
      "status": "流传",
      "effects": {},
      "applied": {},
      "since_turn": 1,
      "when": "承平二十七年春",
      "age": 0,
      "gm_note": "宫里对外的说法，是皇后吩咐内侍监严承恩放出去的；真相是肺疾（秘密 S1）。",
      "log": []
    },
    {
      "id": "R3",
      "text": "寺田要清，和尚要还俗。",
      "truth": "半真",
      "source": "觉明",
      "about": [
        "王延龄"
      ],
      "heat": {
        "长安市井": 3,
        "士林": 1
